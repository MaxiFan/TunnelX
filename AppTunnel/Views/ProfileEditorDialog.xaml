<Window x:Class="AppTunnel.Views.ProfileEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AppTunnel.Converters"
        xmlns:models="clr-namespace:AppTunnel.Models"
        xmlns:services="clr-namespace:AppTunnel.Services"
        Title="Profile Editor"
        Width="650"
        Height="560"
        MinWidth="600"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="DialogSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>
        </Style>
        <Style x:Key="DialogFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>
        </Style>
        <Style x:Key="DialogPersianTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="FlowDirection" Value="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}"/>
            <Setter Property="TextAlignment" Value="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            CornerRadius="18"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="32" Opacity="0.65" ShadowDepth="0"/>
        </Border.Effect>

        <Grid FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="18,18,0,0"
                    Padding="16,12">
                <Grid FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock x:Name="DialogTitleText"
                                   Text="ویرایش پروفایل"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextAlignment="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>
                        <TextBlock x:Name="DialogSubtitleText"
                                   Text="تنظیمات این کانفیگ بعد از ذخیره در لیست پروفایل‌ها نمایش داده می‌شود."
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,5,0,0"
                                   TextAlignment="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource WindowControlButton}"
                            Width="34"
                            Height="30"
                            FontSize="18"
                            Click="OnCancelClick"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}">
                <StackPanel Margin="14,12"
                            FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}">
                    <Border Style="{StaticResource CardPanel}" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogSectionHeader}" Text="اطلاعات پروفایل"/>
                            <TextBlock Style="{StaticResource DialogFieldLabel}" Text="نام پروفایل *"/>
                            <TextBox x:Name="ProfileNameField"
                                     Style="{StaticResource DialogPersianTextBox}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="مثلاً کار، تلگرام، گیمینگ..."
                                     TextChanged="OnProfileNameTextChanged"/>
                            <TextBlock x:Name="ProfileNameValidationText"
                                       Text="نام پروفایل را وارد کنید"
                                       Visibility="Collapsed"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>

                            <TextBlock Style="{StaticResource DialogFieldLabel}" Text="نوع اتصال" Margin="0,8,0,3"/>
                            <ComboBox Style="{StaticResource DarkComboBox}"
                                      FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}"
                                      SelectedValue="{Binding TunnelType, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="L2TP/IPsec"
                                              Tag="{x:Static models:TunnelType.L2tpIpsec}"/>
                                <ComboBoxItem Content="V2Ray / Xray"
                                              Tag="{x:Static models:TunnelType.V2Ray}"/>
                                <ComboBoxItem Content="OpenVPN"
                                              Tag="{x:Static models:TunnelType.OpenVpn}"/>
                                <ComboBoxItem Content="SOCKS / Proxy"
                                              Tag="{x:Static models:TunnelType.SocksProxy}"/>
                                <ComboBoxItem Content="WireGuard"
                                              Tag="{x:Static models:TunnelType.WireGuard}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardPanel}" Padding="12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DialogSectionHeader}" Text="تنظیمات اتصال"/>

                            <StackPanel Visibility="{Binding TunnelType, Converter={StaticResource EnumToVis}, ConverterParameter=L2tpIpsec}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="آدرس سرور"/>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="نام کاربری"/>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="رمز عبور"/>
                                        <PasswordBox x:Name="L2tpPasswordField"
                                                     Style="{StaticResource ModernPasswordBox}"
                                                     FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Pre-Shared Key"/>
                                        <PasswordBox x:Name="PskField"
                                                     Style="{StaticResource ModernPasswordBox}"
                                                     FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding TunnelType, Converter={StaticResource EnumToVis}, ConverterParameter=V2Ray}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="کانفیگ V2Ray / Xray"/>
                                <TextBlock Text="Hysteria 1 و 2 پشتیبانی می‌شود: hysteria:// ، hysteria2:// ، hy2:// یا JSON سینگ‌باکس."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"
                                           FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}"
                                           TextAlignment="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding V2RayConfig, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="112"
                                         FontFamily="Consolas"
                                         FlowDirection="LeftToRight"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="پیست از کلیپ‌بورد"
                                            FontSize="11"
                                            Padding="12,6"
                                            Click="OnPasteV2RayClick"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="پاک کردن"
                                            FontSize="11"
                                            Padding="12,6"
                                            Margin="6,0,0,0"
                                            Click="OnClearV2RayClick"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding TunnelType, Converter={StaticResource EnumToVis}, ConverterParameter=OpenVpn}">
                                <TextBlock x:Name="OpenVpnIntroTextBlock"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Stretch"
                                           FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}"
                                           TextAlignment="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"
                                           Margin="0,0,0,8"/>
                                <Border Background="#1247A3F3" BorderBrush="#2647A3F3" BorderThickness="1"
                                        CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="OpenVpnScenarioTitleTextBlock"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#47A3F3"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Stretch"
                                                   FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}"
                                                   TextAlignment="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>
                                        <TextBlock x:Name="OpenVpnScenarioHintTextBlock"
                                                   FontSize="10" LineHeight="15"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Stretch"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}"
                                                   TextAlignment="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="OpenVpnFileLabelTextBlock"
                                           Style="{StaticResource DialogFieldLabel}"/>
                                <Grid FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="OpenVpnBrowseButton"
                                            Grid.Column="0"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="انتخاب فایل"
                                            FontSize="11"
                                            Padding="12,7"
                                            Click="OnBrowseOpenVpnClick"/>
                                    <TextBox Grid.Column="2"
                                             Style="{StaticResource ModernTextBox}"
                                             Text="{Binding OpenVpnConfigPath}"
                                             IsReadOnly="True"
                                             FlowDirection="LeftToRight"
                                             TextAlignment="Left"/>
                                </Grid>

                                <Grid Margin="0,8,0,0"
                                      FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="OpenVpnUsernameLabelTextBlock"
                                                   Style="{StaticResource DialogFieldLabel}"/>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding OpenVpnUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"
                                                 TextChanged="OnOpenVpnCredentialChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="OpenVpnPasswordLabelTextBlock"
                                                   Style="{StaticResource DialogFieldLabel}"/>
                                        <PasswordBox x:Name="OpenVpnPasswordField"
                                                     Style="{StaticResource ModernPasswordBox}"
                                                     FlowDirection="LeftToRight"
                                                     PasswordChanged="OnOpenVpnCredentialChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock x:Name="OpenVpnSecretLabelTextBlock"
                                                   Style="{StaticResource DialogFieldLabel}"/>
                                        <PasswordBox x:Name="OpenVpnPrivateKeyPasswordField"
                                                     Style="{StaticResource ModernPasswordBox}"
                                                     FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="OpenVpnUpstreamProxyHintTextBlock"
                                           TextWrapping="Wrap"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Stretch"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="OpenVpnUpstreamProxyKindLabel"
                                                   Style="{StaticResource DialogFieldLabel}"
                                                   Text="پراکسی بالادستی"/>
                                        <ComboBox Style="{StaticResource DarkComboBox}"
                                                  SelectedValue="{Binding OpenVpnUpstreamProxyKind, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="OnOpenVpnUpstreamProxyKindChanged">
                                            <ComboBoxItem Content="بدون پراکسی"
                                                          Tag="{x:Static models:OpenVpnUpstreamProxyKind.None}"/>
                                            <ComboBoxItem Content="HTTP"
                                                          Tag="{x:Static models:OpenVpnUpstreamProxyKind.Http}"/>
                                            <ComboBoxItem Content="SOCKS5"
                                                          Tag="{x:Static models:OpenVpnUpstreamProxyKind.Socks}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Visibility="{Binding IsOpenVpnUpstreamProxyEnabled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource DialogFieldLabel}" Text="پورت"/>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding OpenVpnUpstreamProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding IsOpenVpnUpstreamProxyEnabled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource DialogFieldLabel}" Text="آدرس پراکسی"/>
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding OpenVpnUpstreamProxyHost, UpdateSourceTrigger=PropertyChanged}"
                                             FlowDirection="LeftToRight"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource DialogFieldLabel}" Text="نام کاربری پراکسی (اختیاری)"/>
                                            <TextBox Style="{StaticResource ModernTextBox}"
                                                     Text="{Binding OpenVpnUpstreamProxyUsername, UpdateSourceTrigger=PropertyChanged}"
                                                     FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource DialogFieldLabel}" Text="رمز پراکسی (اختیاری)"/>
                                            <PasswordBox x:Name="OpenVpnUpstreamProxyPasswordField"
                                                         Style="{StaticResource ModernPasswordBox}"
                                                         FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding TunnelType, Converter={StaticResource EnumToVis}, ConverterParameter=SocksProxy}">
                                <TextBlock Text="برای SOCKS5 یا HTTP Proxy، اطلاعات سرور را جداگانه وارد کنید."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="نوع پراکسی"/>
                                        <ComboBox Style="{StaticResource DarkComboBox}"
                                                  SelectedValue="{Binding ProxyProtocol, Mode=TwoWay}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="SOCKS5"
                                                          Tag="{x:Static models:ProxyProtocol.Socks5}"/>
                                            <ComboBoxItem Content="HTTP Proxy"
                                                          Tag="{x:Static models:ProxyProtocol.Http}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="پورت"/>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="آدرس IP یا دامنه سرور" Margin="0,8,0,3"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding ProxyServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                         FlowDirection="LeftToRight"/>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="نام کاربری"/>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="رمز عبور"/>
                                        <PasswordBox x:Name="ProxyPasswordField"
                                                     Style="{StaticResource ModernPasswordBox}"
                                                     FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding TunnelType, Converter={StaticResource EnumToVis}, ConverterParameter=WireGuard}">
                                <TextBlock Text="فایل .conf وایرگارد را وارد کنید. در این نسخه فقط کانفیگ‌های تک-peer پشتیبانی می‌شوند و مسیرها توسط TunnelX مدیریت می‌شوند."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="فایل WireGuard (.conf)"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}"
                                             Text="{Binding WireGuardConfigPath}"
                                             IsReadOnly="True"
                                             FlowDirection="LeftToRight"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="انتخاب فایل"
                                            FontSize="11"
                                            Padding="12,7"
                                            Click="OnBrowseWireGuardClick"/>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="کانفیگ WireGuard" Margin="0,8,0,3"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding WireGuardConfig, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="112"
                                         FontFamily="Consolas"
                                         FlowDirection="LeftToRight"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="پیست از کلیپ‌بورد"
                                            FontSize="11"
                                            Padding="12,6"
                                            Click="OnPasteWireGuardClick"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="پاک کردن"
                                            FontSize="11"
                                            Padding="12,6"
                                            Margin="6,0,0,0"
                                            Click="OnClearWireGuardClick"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,18,18"
                    Padding="14,10">
                <Grid FlowDirection="{Binding Source={x:Static services:LocalizationService.Instance}, Path=FlowDirection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButton}"
                            Content="ذخیره"
                            MinWidth="110"
                            Padding="18,8"
                            Click="OnSaveClick"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Content="لغو"
                            MinWidth="92"
                            Padding="16,8"
                            Click="OnCancelClick"/>
                    <TextBlock x:Name="ValidationText"
                               Grid.Column="4"
                               FontSize="11"
                               Foreground="{StaticResource WarningBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               TextAlignment="{Binding Source={x:Static services:LocalizationService.Instance}, Path=TextAlignment}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
