<Window x:Class="AppTunnel.Views.ConnectionErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AppTunnel.Converters"
        xmlns:services="clr-namespace:AppTunnel.Services"
        Title="اتصال برقرار نشد"
        Width="420"
        MinWidth="380"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="{Binding AppFlowDirection}"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <conv:StringToColorConverter x:Key="StringToColor"/>

        <Style x:Key="DialogBodyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
            <Setter Property="TextAlignment" Value="{Binding AppTextAlignment, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Style>

        <Style x:Key="DialogGlyphText" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyText}">
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            CornerRadius="16"
            BorderBrush="#66E05252"
            BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" Opacity="0.7" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="20"
              FlowDirection="{Binding AppFlowDirection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="❌"
                       FontSize="28"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1"
                       Text="{Binding ConnectionErrorHeaderText}"
                       Style="{StaticResource DialogBodyText}"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#E05252"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding ConnectionErrorDetail}"
                       Style="{StaticResource DialogBodyText}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       LineHeight="18"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Stretch"
                       Margin="0,0,0,12"/>

            <Border Grid.Row="3"
                    Background="#2A1212"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="220">
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectionStagesHeaderText}"
                                   Style="{StaticResource DialogBodyText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ConnectionSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource DialogGlyphText}"
                                                   Text="{Binding StateGlyph}"
                                                   Width="16"
                                                   FontSize="10"
                                                   Margin="0,0,8,0"
                                                   Foreground="{Binding StateColor, Converter={StaticResource StringToColor}}"/>
                                        <TextBlock Style="{StaticResource DialogBodyText}"
                                                   Text="{Binding Title}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Button Grid.Row="4"
                    Content="{Binding ConnectionErrorCloseButtonText}"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="120"
                    Padding="18,8"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    Click="OnCloseClick"/>
        </Grid>
    </Border>
</Window>
